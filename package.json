{
  "name": "learning-process-manager",
  "version": "0.1.0-alpha.2",
  "description": "学习进度管理 CLI 工具，支持 FSRS 和艾宾浩斯间隔重复算法",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "homepage": "https://github.com/v-liuxingan/learning-process-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v-liuxingan/learning-process-manager.git"
  },
  "bugs": {
    "url": "https://github.com/v-liuxingan/learning-process-manager/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "learn": "./dist/bin/learn.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run tests",
    "test:watch": "vitest tests",
    "test:run": "vitest --run tests",
    "test:e2e": "vitest --run e2e",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=moderate",
    "pack:dry-run": "npm pack --dry-run",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run test:e2e && npm run audit && npm run pack:dry-run",
    "clean": "rimraf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "learning",
    "spaced-repetition",
    "fsrs",
    "flashcard",
    "study",
    "progress-tracker"
  ],
  "author": "learning-process-manager contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "ora": "^8.0.0",
    "ts-fsrs": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
